# Copy to .env in the folder of the agent you are running (or export these in your shell).
# Never commit the real .env file.

# ---- Option 1: Google AI Studio (fastest for local development) ----
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key

# ---- Option 2: Vertex AI (required for Cloud Run / Agent Engine deployments) ----
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Models (override per agent if you like) ----
# gemini-2.0-flash was shut down on June 1, 2026, and 2.5 models are limited to
# existing users, so these defaults use the current Gemini 3.x line.
FAST_MODEL=gemini-3.8-flash
ADVANCED_MODEL=gemini-3.8-flash
# For deeper reasoning (lead-gen synthesis, code-review critic) try:
# ADVANCED_MODEL=gemini-3.1-pro-preview

# ---- (c) Bug assistant ----
MCP_TOOLBOX_URL=http://127.0.0.1:5000
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_read_only_public_repos

# ---- (e) E-commerce agent ----
ECOMMERCE_TOOLBOX_URL=http://127.0.0.1:5001
AUTH_MODE=demo                 # demo (local) | google (verified Google Sign-In)
DEMO_USER_EMAIL=alex.rivera@example.com
GOOGLE_OAUTH_CLIENT_ID=        # required when AUTH_MODE=google
